# Clay Public API (sourcing directo, sin Make)
# Settings → Account → API keys (beta). Header: clay-api-key
CLAY_API_KEY=clay_xxxxxxxxxxxxxxxxxxxxxxxx
# De la URL: https://app.clay.com/workspaces/.../tables/t_XXXX
CLAY_TABLE_ID=t_xxxxxxxxxxxxxxxx
# Nombres exactos de columnas en tu tabla Clay (opcional)
CLAY_FIELD_COMPANY=Company Name
CLAY_FIELD_DOMAIN=Domain
CLAY_FIELD_PHONE=Phone
CLAY_FIELD_ADDRESS=Address
CLAY_FIELD_EMAIL=Email
CLAY_FIELD_LINKEDIN=LinkedIn URL
# Filtros opcionales (columna Clay que contiene nicho / ubicación)
CLAY_FILTER_NICHO_FIELD=
CLAY_FILTER_UBICACION_FIELD=
# Webhook legado (solo si no hay Table ID)
CLAY_WEBHOOK_URL=
CLAY_LINKEDIN_WEBHOOK_URL=https://hook.eu1.make.com/clay-linkedin-xxxxxxxx

